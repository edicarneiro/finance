# ADR-0026: variáveis para `docker compose -f docker-compose.dev.yml up`.
# Copie para .env (git-ignorado) e ajuste se necessário — os valores abaixo já funcionam para dev local.

POSTGRES_DB=financepulse_dev
POSTGRES_USER=fp_user
POSTGRES_PASSWORD=fp_password

FINANCEPULSE_JWT_SECRET=change-me-in-dev
FINANCEPULSE_SEED_ENABLED=true
